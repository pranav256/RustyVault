{
  "manifest_version": 3,
  "name": "RustyVault",
  "version": "0.1.0",
  "description": "Save and fill website logins through your unlocked RustyVault desktop app.",
  "browser_specific_settings": {
    "gecko": {
      "id": "rustyvault@pranav256.com",
      "strict_min_version": "128.0"
    }
  },
  "key": "",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "RustyVault",
    "default_popup": "popup.html"
  },
  "minimum_chrome_version": "121"
}
